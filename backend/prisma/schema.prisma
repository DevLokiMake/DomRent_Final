

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  LANDLORD
  ADMIN
}

enum ContractType {
  RENT
  SALE
}

enum BookingStatus {
  PENDING     // Ожидает подтверждения арендодателя
  UPCOMING    // Подтверждено, ещё не началось
  ACTIVE      // Идёт прямо сейчас
  COMPLETED   // Завершено
  CANCELLED   // Отменено
}

enum ModerationStatus {
  PENDING    // На проверке (не видно в поиске)
  APPROVED   // Одобрено
  REJECTED   // Отклонено (с причиной)
}

model City {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  properties     Property[]
  priceSnapshots PriceSnapshot[]
  createdAt      DateTime        @default(now())
}

model User {
  id         Int        @id @default(autoincrement())
  email      String     @unique
  password   String
  name       String?
  phone      String?
  avatar     String?    // URL аватара (Cloudinary)
  telegramId    String?
  expoPushToken String?    // Expo push notification token
  role          Role       @default(USER)
  isBanned      Boolean    @default(false)
  // Дефолт true — чтобы существующие пользователи (созданные до этой миграции) не потеряли доступ.
  // Контроллер регистрации явно ставит false для новых аккаунтов, требующих подтверждения email.
  isEmailVerified     Boolean               @default(true)
  properties    Property[]
  bookings      Booking[]
  favorites     Favorite[]
  reviews       Review[]       @relation("ReviewAuthor")
  sentMessages  Message[]      @relation("MessageSender")
  notifications       Notification[]
  auditLogs           AuditLog[]          @relation("AuditAdmin")
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  createdAt           DateTime            @default(now())
}

model Property {
  id              Int              @id @default(autoincrement())
  title           String
  description     String
  price           Float
  type            String           // квартира, дом, комната
  contractType    ContractType     @default(RENT)
  rooms           Int?             // Количество комнат
  hasWifi         Boolean          @default(false)
  hasParking      Boolean          @default(false)
  petsAllowed     Boolean          @default(false)
  viewCount       Int              @default(0)  // Счётчик просмотров
  status          ModerationStatus @default(PENDING)
  rejectionReason String?          // Причина отклонения от админа
  cityId          Int
  city            City             @relation(fields: [cityId], references: [id])
  images          String[]
  coverImage      String?
  latitude        Float?
  longitude       Float?
  ownerId         Int
  owner           User             @relation(fields: [ownerId], references: [id])
  bookings        Booking[]
  favorites       Favorite[]
  reviews         Review[]
  blockedDates    BlockedDate[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([latitude, longitude])
  @@index([status])
}

model BlockedDate {
  id         Int      @id @default(autoincrement())
  propertyId Int
  date       DateTime @db.Date  // Только дата без времени
  reason     String?            // "booking" | "manual" | custom text
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([propertyId, date])
  @@index([propertyId])
}

model Booking {
  id         Int           @id @default(autoincrement())
  startDate  DateTime
  endDate    DateTime
  totalPrice Float
  status     BookingStatus @default(PENDING)
  userId     Int
  propertyId Int
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reviews    Review[]
  messages   Message[]
  createdAt  DateTime      @default(now())

  @@index([userId, status])
  @@index([propertyId, status])
}

model Favorite {
  id         Int      @id @default(autoincrement())
  userId     Int
  propertyId Int
  user       User     @relation(fields: [userId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id])
  @@unique([userId, propertyId])
}

// ─── Отзывы ─────────────────────────────────────────────────────────────────

model Review {
  id         Int      @id @default(autoincrement())
  rating     Int
  text       String
  anonymous  Boolean  @default(false)
  authorId   Int
  propertyId Int
  bookingId  Int?     @unique
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@index([authorId])
}

// ─── Чат ────────────────────────────────────────────────────────────────────

model Message {
  id         Int      @id @default(autoincrement())
  text       String
  senderId   Int
  bookingId  Int
  isRead     Boolean  @default(false)
  sender     User     @relation("MessageSender", fields: [senderId], references: [id])
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([bookingId, createdAt])
}

// ─── In-app уведомления ──────────────────────────────────────────────────────

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  entityId  Int?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

// ─── Журнал действий администраторов ────────────────────────────────────────

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    Int
  action     String   // BAN_USER | UNBAN_USER | APPROVE_PROPERTY | REJECT_PROPERTY | CHANGE_ROLE
  targetId   Int?     // userId или propertyId
  targetType String?  // "USER" | "PROPERTY"
  details    Json?    // дополнительный контекст (причина отклонения, новая роль и т.д.)
  admin      User     @relation("AuditAdmin", fields: [adminId], references: [id])
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([createdAt])
  @@index([action])
}

enum NotificationType {
  BOOKING_NEW
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  MESSAGE_NEW
  REVIEW_NEW
  PROPERTY_APPROVED
  PROPERTY_REJECTED
}

model PasswordResetToken {
  token     String   @id
  userId    Int
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  token     String   @id
  userId    Int
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Денилист отозванных JWT (по jti) — токен остаётся здесь до истечения своего срока,
/// после чего jwt.verify и так отклонит его по expiresAt; запись можно удалять (см. cron cleanup).
model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// Ежедневный снимок средней цены по городу+типу сделки — копится с момента добавления
/// этой модели (реальные данные, без фабрикации истории). См. src/jobs/priceSnapshot.js.
model PriceSnapshot {
  id           Int          @id @default(autoincrement())
  cityId       Int
  contractType ContractType
  avgPrice     Float
  sampleSize   Int
  capturedAt   DateTime     @default(now())
  city         City         @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId, contractType, capturedAt])
}
